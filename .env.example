# SMP - Shop Management Platform Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/smp_db

# Security & Authentication
JWT_SECRET=smp_super_secure_jwt_secret_key_2026_production_ready
JWT_EXPIRE=7d

# SMS Gateway (Fast2SMS / Twilio / MSG91)
# When MOCK_SMS=true, OTP is logged to server console and sent in dev response
MOCK_SMS=true
SMS_GATEWAY_API_KEY=your_sms_gateway_api_key_here
SMS_SENDER_ID=SMPSHP

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=SMP Support <noreply@smpshop.com>

# Payment Gateway (Razorpay / Stripe)
# When MOCK_PAYMENT=true, simulated secure payments are executed
MOCK_PAYMENT=true
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Uploads
UPLOAD_PATH=uploads
MAX_FILE_SIZE=5242880

# Required for production/Vercel image uploads (never commit real credentials)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional; defaults to smp-products
CLOUDINARY_UPLOAD_FOLDER=smp-products
