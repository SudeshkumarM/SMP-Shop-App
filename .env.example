# SMP - Shop Management Platform Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
# Required for both local development and Vercel. Use the Atlas cluster host and URL-encode special characters in the password.
# Format: mongodb+srv://<username>:<URL_ENCODED_PASSWORD>@<actual-cluster-host>/test?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://YOUR_ATLAS_USERNAME:YOUR_ATLAS_PASSWORD@YOUR_CLUSTER.mongodb.net/test?retryWrites=true&w=majority

# Owner Setup
OWNER_SETUP_TOKEN=YOUR_RANDOM_OWNER_SETUP_TOKEN_AT_LEAST_32_CHARACTERS
OWNER_INITIAL_NAME=YOUR_OWNER_NAME
OWNER_INITIAL_USERNAME=YOUR_OWNER_USERNAME
OWNER_INITIAL_EMAIL=YOUR_OWNER_EMAIL
OWNER_INITIAL_PASSWORD=YOUR_NEW_STRONG_OWNER_PASSWORD
OWNER_INITIAL_PHONE=0000000000

# Security & Authentication
JWT_SECRET=YOUR_NEW_RANDOM_JWT_SECRET
JWT_EXPIRE=7d

# OTP for account recovery (no registration OTP is used)
MSG91_AUTH_KEY=YOUR_MSG91_AUTH_KEY
MSG91_TEMPLATE_ID=YOUR_APPROVED_MSG91_FLOW_TEMPLATE_ID
MSG91_OTP_VARIABLE=OTP
OTP_HASH_SECRET=YOUR_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SMS_SENDER_ID=YOUR_APPROVED_SENDER_ID

# Alternative SMS API (optional)
SMS_API_URL=
SMS_API_KEY=
# Set MOCK_SMS=true to simulate SMS sending without actual API calls
MOCK_SMS=false

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=SMP Support <noreply@smpshop.com>

# Payment Gateway (Razorpay / Stripe)
# When MOCK_PAYMENT=true, simulated secure payments are executed
MOCK_PAYMENT=true
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Uploads
UPLOAD_PATH=uploads
MAX_FILE_SIZE=5242880

# Required for production/Vercel image uploads (never commit real credentials)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional; defaults to smp-products
CLOUDINARY_UPLOAD_FOLDER=smp-products

# Performance tuning
UV_THREADPOOL_SIZE=128
