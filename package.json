{
  "name": "smp-retail-app",
  "version": "1.0.0",
  "description": "SMP - Scalable E-Commerce & Multi-Module Retail System",
  "scripts": {
    "dev": "node dev.js",
    "start": "node dev.js",
    "server": "npm --prefix backend start",
    "client": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "seed": "npm --prefix backend run seed",
    "test:e2e": "npm --prefix backend run test:e2e",
    "test:load": "npm --prefix backend run test:load",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install"
  },
  "keywords": [
    "ecommerce",
    "pos",
    "retail",
    "multi-shop",
    "dress-shop",
    "management"
  ],
